vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

.DS_Store

# Python 검증기·로컬 테스트의 캐시는 배포 원본이 아니다.
__pycache__/
*.pyc

*.js
!jest.config.js
*.d.ts
node_modules

# CDK asset staging directory
.cdk.staging
cdk.out

# AWS 계정별 조회 결과가 포함되는 CDK 로컬 context 캐시
cdk.context.json

# 배포 output과 계정별 Helm values는 로컬 생성물이다.
generated/

# 검증한 upstream Helm archive는 버전·checksum과 함께 보관한다.
!helm/dev/platform/lbc/vendor/aws-load-balancer-controller-3.6.0.tgz
!helm/dev/platform/argocd/vendor/argo-cd-10.11.7.tgz
!helm/dev/platform/cert-manager/vendor/cert-manager-v1.21.3.tgz
# PROJ-287: Argo가 네트워크 의존성 해석 없이 소비하는 고정 archive다.
!helm/dev/runtime/vendor/secrets-store-csi-driver-1.6.1.tgz
!helm/dev/runtime/vendor/secrets-store-csi-driver-provider-aws-3.1.4.tgz
!helm/dev/runtime/vendor/fluent-bit-0.58.3.tgz
!helm/observability/pulsemetry-observability/charts/kube-prometheus-stack-81.2.2.tgz
!helm/observability/loki/charts/loki-18.15.1.tgz
!helm/observability/tempo/charts/tempo-3.1.0.tgz
!helm/observability/otel-platform/charts/opentelemetry-collector-0.175.1.tgz
