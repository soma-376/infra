    "broker_count": 3,
    "volume_gib": 100,
    "partitions": 6,
    "replication_factor": 3,
    "min_insync_replicas": 2,
    "retention_hours": 72,
    "max_message_bytes": 13631488,
    "storage_class": "pulsemetry-perf-kafka-gp3"
