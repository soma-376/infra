      "memory_limit_bytes": 1073741824
    }
  },
  "jobs": {
    "seed": {
      "node_pool": "system",
      "cpu_request_millicores": 250,
      "memory_request_bytes": 536870912,
      "memory_limit_bytes": 1073741824
