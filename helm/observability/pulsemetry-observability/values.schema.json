{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "pulsemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "environment",
            "targetNamespace",
            "region",
            "clusterName",
            "grafanaAdminSecretArn",
            "applicationLogGroup",
            "observabilityLogGroup",
            "kubernetesEventsLogGroup",
            "diagnosticsBucket",
            "topic",
            "consumerGroup",
            "controlPlaneLogGroup",
            "kafkaProvider"
          ],
          "properties": {
            "environment": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_./:+-]+$"
            },
            "targetNamespace": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_./:+-]+$"
            },
            "region": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_./:+-]+$"
            },
            "clusterName": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_./:+-]+$"
            },
            "grafanaAdminSecretArn": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_./:+-]+$"
            },
            "mskClusterName": {
              "type": "string",
              "pattern": "^$|^[A-Za-z0-9_./:+-]+$"
            },
            "applicationLogGroup": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_./:+-]+$"
            },
            "brokerLogGroup": {
              "type": "string",
              "pattern": "^$|^[A-Za-z0-9_./:+-]+$"
            },
            "observabilityLogGroup": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_./:+-]+$"
            },
            "kubernetesEventsLogGroup": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_./:+-]+$"
            },
            "diagnosticsBucket": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_./:+-]+$"
            },
            "topic": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_./:+-]+$"
            },
            "consumerGroup": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_./:+-]+$"
            },
            "mskBrokers": {
              "type": "array",
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "controlPlaneLogGroup": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_./:+-]+$"
            },
            "kafkaProvider": {
              "enum": [
                "msk",
                "strimzi"
              ]
            },
            "kafkaClusterName": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kafkaProvider": {
                    "const": "msk"
                  }
                }
              },
              "then": {
                "required": [
                  "mskClusterName",
                  "mskBrokers",
                  "brokerLogGroup"
                ],
                "properties": {
                  "mskClusterName": {
                    "minLength": 1
                  },
                  "brokerLogGroup": {
                    "minLength": 1
                  },
                  "mskBrokers": {
                    "minItems": 3
                  }
                }
              },
              "else": {
                "required": [
                  "kafkaClusterName"
                ],
                "properties": {
                  "kafkaClusterName": {
                    "minLength": 1
                  },
                  "environment": {
                    "const": "dev"
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
