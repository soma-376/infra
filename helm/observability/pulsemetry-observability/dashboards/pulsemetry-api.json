    {
      "type": "timeseries",
      "title": "RDS 커넥션 풀",
      "description": "빈 시계열은 대상 없음·수집 실패·지표 미적용·필터 불일치·표본 부족 중 하나일 수 있다. 첫 화면의 수집 상태 표로 수집 여부를 먼저 보고, 정상이어도 이벤트 없음으로 단정하지 않는다. 0으로 대체하지 않으며 시각은 UTC다. pool은 enrollment가 HikariPool-1, dashboard가 dashboard-rds-source(원천 읽기)·dashboard-rds-cache(캐시)다. pending이 계속 0보다 크면 풀이 부족하다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service,pool)(hikaricp_connections_active{environment=\"$environment\",cluster=\"$cluster\",namespace=\"$namespace\",service=~\"$service\",pod=~\"$pod\"})",
          "legendFormat": "{{service}} {{pool}} active",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by(service,pool)(hikaricp_connections_pending{environment=\"$environment\",cluster=\"$cluster\",namespace=\"$namespace\",service=~\"$service\",pod=~\"$pod\"})",
          "legendFormat": "{{service}} {{pool}} pending",
          "range": true
        },
        {
          "refId": "C",
          "expr": "sum by(service,pool)(hikaricp_connections_max{environment=\"$environment\",cluster=\"$cluster\",namespace=\"$namespace\",service=~\"$service\",pod=~\"$pod\"})",
          "legendFormat": "{{service}} {{pool}} max",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "값 없음 · 첫 화면 수집 상태 확인",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
