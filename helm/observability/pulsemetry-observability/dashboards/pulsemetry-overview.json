    {
      "type": "timeseries",
      "title": "서버 수신 → 완료 p95",
      "description": "Gateway envelope 실제 수신 시각부터 Pipeline 완료까지다. 과거로 이동된 OTLP source_time을 사용하지 않는다. ClickHouse 조회 가시성 확인을 대신하지 않는다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(signal,le)(rate(pulsemetry_pipeline_accepted_to_completion_seconds_bucket{environment=\"$environment\",cluster=\"$cluster\",namespace=\"$namespace\",service=~\"$service\",pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "{{signal}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "미수집",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
