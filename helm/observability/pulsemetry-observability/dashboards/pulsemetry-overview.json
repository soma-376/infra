{
  "uid": "pulsemetry-overview",
  "title": "Pulsemetry · 수집 경로와 k6",
  "description": "빈 시계열은 미수집/비활성/표본 부족이다. 0 또는 정상으로 대체하지 않는다. 시각은 UTC이며 HTTP ACK는 저장 완료가 아니다.",
  "tags": [
    "pulsemetry",
    "PROJ-191"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "constant",
        "query": "__ENVIRONMENT__",
        "hide": 2,
        "current": {
          "text": "__ENVIRONMENT__",
          "value": "__ENVIRONMENT__"
        }
      },
      {
        "name": "namespace",
        "type": "constant",
        "query": "__TARGET_NAMESPACE__",
        "hide": 2,
        "current": {
          "text": "__TARGET_NAMESPACE__",
          "value": "__TARGET_NAMESPACE__"
        }
      },
      {
        "name": "cluster",
        "type": "constant",
        "query": "__CLUSTER_NAME__",
        "hide": 2,
        "current": {
          "text": "__CLUSTER_NAME__",
          "value": "__CLUSTER_NAME__"
        }
      },
      {
        "name": "msk_cluster",
        "type": "constant",
        "query": "__MSK_CLUSTER__",
        "hide": 2,
        "current": {
          "text": "__MSK_CLUSTER__",
          "value": "__MSK_CLUSTER__"
        }
      },
      {
        "name": "topic",
        "type": "constant",
        "query": "__TOPIC__",
        "hide": 2,
        "current": {
          "text": "__TOPIC__",
          "value": "__TOPIC__"
        }
      },
      {
        "name": "consumer_group",
        "type": "constant",
        "query": "__CONSUMER_GROUP__",
        "hide": 2,
        "current": {
          "text": "__CONSUMER_GROUP__",
          "value": "__CONSUMER_GROUP__"
        }
      },
      {
        "name": "testid",
        "label": "k6 실행",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsemetry-prometheus"
        },
        "query": "label_values(k6_http_reqs_total{environment=\"$environment\",cluster=\"$cluster\"}, testid)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "실행을 선택하세요",
          "value": ""
        }
      },
      {
        "name": "application",
        "label": "앱",
        "type": "custom",
        "query": "telemetry-gateway,telemetry-ingest",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsemetry-prometheus"
        },
        "query": "label_values(up{cluster=\"$cluster\",namespace=\"$namespace\",job=~\"telemetry-gateway|telemetry-ingest|clickhouse\"}, service)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsemetry-prometheus"
        },
        "query": "label_values(up{cluster=\"$cluster\",namespace=\"$namespace\",service=~\"$service\",job=~\"telemetry-gateway|telemetry-ingest|clickhouse\"}, pod)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 180, 0, 1)",
        "name": "실행 구간과 운영 개입",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 180, 0, 1)",
        "name": "공유 k6 실행 구간",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [
            "pulsemetry-run",
            "$testid"
          ],
          "type": "tags"
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Pulsemetry 대시보드",
      "tags": [
        "pulsemetry"
      ],
      "keepTime": true,
      "includeVars": true
    }
  ],
  "panels": [
    {
      "type": "table",
      "title": "구성요소별 수집 상태",
      "description": "현재 상태는 scrape 결과다. 정상·일부 실패(기대 target 수 미달 포함)·전체 실패·대상 없음을 구분하고, k6는 remote-write 수신 유무만 본다. 선택 기간 수집률은 예정 scrape 중 성공 비율이며, 빈 칸은 그 기간에 대상이 없었다는 뜻이다. 마지막 성공 후 경과가 빈 칸이면 24시간 안에 성공한 scrape가 없다. 업무 이벤트 유무는 각 상세 화면에서 본다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pulsemetry-prometheus"
          },
          "expr": "pulsemetry:collection_state",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "pulsemetry-prometheus"
          },
          "expr": "avg_over_time(pulsemetry:collection_success:ratio[$__range])",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "pulsemetry-prometheus"
          },
          "expr": "time() - max_over_time(pulsemetry:collection_last_success:timestamp[24h])",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "component": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "dashboard": 4
            },
            "renameByName": {
              "component": "구성요소",
              "Value #A": "현재 상태",
              "Value #B": "선택 기간 수집률",
              "Value #C": "마지막 성공 후 경과",
              "dashboard": "상세 화면"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "미수집 · Prometheus rule 결과 없음",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "현재 상태"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "2": {
                        "text": "정상",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "일부 실패",
                        "color": "orange",
                        "index": 1
                      },
                      "0": {
                        "text": "전체 실패",
                        "color": "red",
                        "index": 2
                      },
                      "-1": {
                        "text": "대상 없음 · 배포/설정 필요",
                        "color": "purple",
                        "index": 3
                      },
                      "-2": {
                        "text": "최근 수신 없음 · 실행 없음",
                        "color": "text",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "선택 기간 수집률"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "마지막 성공 후 경과"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "상세 화면"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "상세 대시보드 열기",
                    "url": "/d/${__value.raw}?${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "현재 상태",
            "desc": false
          }
        ]
