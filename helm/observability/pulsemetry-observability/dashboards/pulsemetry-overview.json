    {
      "type": "timeseries",
      "title": "MSK commit 기준 총 lag · 60초",
      "description": "CloudWatch 60초, commit 기준 offset lag. STABLE/EMPTY 및 commit된 offset이 있어야 방출된다. rebalance·미수집을 0으로 해석하지 않는다. Kafka record 수이며 OTLP 관측 행 수와 다르다.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "pulsemetry-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "pulsemetry-cloudwatch"
          },
          "queryMode": "Metrics",
          "region": "__AWS_REGION__",
          "namespace": "AWS/Kafka",
          "metricName": "SumOffsetLag",
          "dimensions": {
            "Cluster Name": "$msk_cluster",
            "Consumer Group": "$consumer_group",
            "Topic": "$topic"
          },
          "statistic": "Maximum",
          "period": "60",
          "matchExact": true,
          "metricEditorMode": 0,
          "metricQueryType": 0
        }
