        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "links": [
        {
          "title": "같은 시간·서비스·Pod의 진단 로그",
          "url": "/d/pulsemetry-diagnostics?${__url_time_range}&${environment:queryparam}&${cluster:queryparam}&${namespace:queryparam}&${service:queryparam}&${pod:queryparam}&${testid:queryparam}",
          "targetBlank": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Gateway 요청 / 초",
      "description": "빈 시계열은 미수집/비활성/표본 부족이다. 0 또는 정상으로 대체하지 않는다. 시각은 UTC이며 HTTP ACK는 저장 완료가 아니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(signal,outcome)(pulsemetry:gateway_requests:rate1m{environment=\"$environment\",cluster=\"$cluster\",namespace=\"$namespace\",service=~\"$service\",pod=~\"$pod\"})",
          "legendFormat": "{{signal}} {{outcome}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "미수집",
