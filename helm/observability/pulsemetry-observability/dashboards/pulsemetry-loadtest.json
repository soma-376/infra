        {
          "refId": "A",
          "expr": "sum(rate(k6_http_req_failed_total{cluster=\"$cluster\",testid=\"$testid\",name=~\"/v1/.*\",condition=\"nonzero\"}[$__rate_interval])) / sum(rate(k6_http_req_failed_total{cluster=\"$cluster\",testid=\"$testid\",name=~\"/v1/.*\"}[$__rate_interval]))",
          "legendFormat": "오류율",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
