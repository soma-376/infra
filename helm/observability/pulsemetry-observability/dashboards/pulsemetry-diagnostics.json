    {
      "type": "timeseries",
      "title": "GC pause 평균",
      "description": "실제 앱은 summary count/sum을 방출한다. 평균은 p95가 아니며 GC가 없으면 분모0으로 값이 없다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(application)(rate(jvm_gc_pause_seconds_sum{application=~\"$application\",cluster=\"$cluster\",namespace=\"$namespace\",service=~\"$service\",pod=~\"$pod\"}[$__rate_interval])) / sum by(application)(rate(jvm_gc_pause_seconds_count{application=~\"$application\",cluster=\"$cluster\",namespace=\"$namespace\",service=~\"$service\",pod=~\"$pod\"}[$__rate_interval]))",
