{
  "uid": "pulsemetry-k6-readiness",
  "title": "Pulsemetry · k6 준비도",
  "description": "격리 perf 실행의 hold 구간 요청 지표·전송량·발생기 자원을 함께 본다. 미수집은 0이 아니며 정식 판정은 journal·readiness·최종 저장 증거로 수행한다.",
  "tags": [
    "pulsemetry",
    "PROJ-296"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "constant",
        "query": "__ENVIRONMENT__",
        "hide": 2,
        "current": {
          "text": "__ENVIRONMENT__",
          "value": "__ENVIRONMENT__"
        }
      },
      {
        "name": "namespace",
        "type": "constant",
        "query": "__TARGET_NAMESPACE__",
        "hide": 2,
        "current": {
          "text": "__TARGET_NAMESPACE__",
          "value": "__TARGET_NAMESPACE__"
        }
      },
      {
        "name": "cluster",
        "type": "constant",
        "query": "__CLUSTER_NAME__",
        "hide": 2,
        "current": {
          "text": "__CLUSTER_NAME__",
          "value": "__CLUSTER_NAME__"
        }
      },
      {
        "name": "environment_id",
        "label": "시험 환경 ID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsemetry-prometheus"
        },
        "query": "label_values(k6_otlp_requests_started_total{environment=\"$environment\",cluster=\"$cluster\"},environment_id)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "선택하세요",
          "value": ""
        }
      },
      {
        "name": "testid",
        "label": "실행 ID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsemetry-prometheus"
        },
        "query": "label_values(k6_otlp_requests_started_total{environment=\"$environment\",cluster=\"$cluster\",environment_id=\"$environment_id\"},testid)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "선택하세요",
          "value": ""
        }
      },
      {
        "name": "generator_id",
        "label": "발생기 ID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsemetry-prometheus"
        },
        "query": "label_values(k6_otlp_requests_started_total{environment=\"$environment\",cluster=\"$cluster\",testid=\"$testid\"},generator_id)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "선택하세요",
          "value": ""
        }
      },
      {
        "name": "generator_namespace",
        "label": "발생기 namespace",
        "type": "textbox",
        "query": "pulsemetry-perf-runner",
        "current": {
          "text": "pulsemetry-perf-runner",
          "value": "pulsemetry-perf-runner"
        }
      },
      {
        "name": "generator_pod",
        "label": "발생기 Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsemetry-prometheus"
        },
        "query": "label_values(kube_pod_info{environment=\"$environment\",cluster=\"$cluster\",namespace=\"$generator_namespace\"},pod)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "선택하세요",
          "value": ""
        }
      },
      {
        "name": "generator_node",
        "label": "발생기 노드",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsemetry-prometheus"
        },
        "query": "label_values(kube_pod_info{environment=\"$environment\",cluster=\"$cluster\",namespace=\"$generator_namespace\",pod=\"$generator_pod\"},node)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "선택하세요",
          "value": ""
        }
      },
      {
        "name": "generator_instance",
        "label": "노드 exporter",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsemetry-prometheus"
        },
        "query": "label_values(node_uname_info{environment=\"$environment\",cluster=\"$cluster\",nodename=\"$generator_node\"},instance)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "선택하세요",
          "value": ""
        }
      },
      {
        "name": "physical_interface",
        "label": "물리 NIC (실제 경로 확인)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsemetry-prometheus"
        },
        "query": "label_values(node_network_info{environment=\"$environment\",cluster=\"$cluster\",instance=\"$generator_instance\",operstate=\"up\"},device)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "선택하세요",
          "value": ""
        }
      },
      {
        "name": "service",
        "type": "constant",
        "query": ".*",
        "hide": 2,
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "pod",
        "type": "constant",
        "query": ".*",
        "hide": 2,
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
