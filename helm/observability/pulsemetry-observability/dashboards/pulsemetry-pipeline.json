{
  "uid": "pulsemetry-pipeline",
  "title": "Pulsemetry · Pipeline",
  "description": "빈 시계열은 미수집/비활성/표본 부족이다. 0 또는 정상으로 대체하지 않는다. 시각은 UTC이며 HTTP ACK는 저장 완료가 아니다.",
  "tags": [
    "pulsemetry",
    "PROJ-191"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "constant",
        "query": "__ENVIRONMENT__",
        "hide": 2,
        "current": {
          "text": "__ENVIRONMENT__",
          "value": "__ENVIRONMENT__"
        }
      },
      {
        "name": "namespace",
        "type": "constant",
        "query": "__TARGET_NAMESPACE__",
        "hide": 2,
        "current": {
          "text": "__TARGET_NAMESPACE__",
          "value": "__TARGET_NAMESPACE__"
        }
      },
      {
        "name": "cluster",
        "type": "constant",
        "query": "__CLUSTER_NAME__",
        "hide": 2,
        "current": {
          "text": "__CLUSTER_NAME__",
          "value": "__CLUSTER_NAME__"
        }
      },
      {
        "name": "msk_cluster",
        "type": "constant",
        "query": "__MSK_CLUSTER__",
        "hide": 2,
        "current": {
          "text": "__MSK_CLUSTER__",
          "value": "__MSK_CLUSTER__"
        }
      },
      {
        "name": "topic",
        "type": "constant",
        "query": "__TOPIC__",
        "hide": 2,
        "current": {
          "text": "__TOPIC__",
          "value": "__TOPIC__"
        }
      },
      {
        "name": "consumer_group",
        "type": "constant",
        "query": "__CONSUMER_GROUP__",
        "hide": 2,
        "current": {
          "text": "__CONSUMER_GROUP__",
          "value": "__CONSUMER_GROUP__"
        }
      },
      {
        "name": "testid",
        "label": "k6 실행",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsemetry-prometheus"
        },
        "query": "label_values(k6_http_reqs_total{environment=\"$environment\",cluster=\"$cluster\"}, testid)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "실행을 선택하세요",
          "value": ""
        }
      },
      {
        "name": "application",
        "label": "앱",
        "type": "custom",
        "query": "telemetry-gateway,telemetry-ingest",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsemetry-prometheus"
        },
        "query": "label_values(up{cluster=\"$cluster\",namespace=\"$namespace\",job=~\"telemetry-gateway|telemetry-ingest|clickhouse\"}, service)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsemetry-prometheus"
        },
        "query": "label_values(up{cluster=\"$cluster\",namespace=\"$namespace\",service=~\"$service\",job=~\"telemetry-gateway|telemetry-ingest|clickhouse\"}, pod)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 180, 0, 1)",
        "name": "실행 구간과 운영 개입",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 180, 0, 1)",
        "name": "공유 k6 실행 구간",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [
            "pulsemetry-run",
            "$testid"
          ],
          "type": "tags"
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Pulsemetry 대시보드",
      "tags": [
        "pulsemetry"
      ],
      "keepTime": true,
      "includeVars": true
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "시도 결과 / 초",
      "description": "빈 시계열은 미수집/비활성/표본 부족이다. 0 또는 정상으로 대체하지 않는다. 시각은 UTC이며 HTTP ACK는 저장 완료가 아니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(signal,outcome)(pulsemetry:pipeline_attempts:rate1m{environment=\"$environment\",cluster=\"$cluster\",namespace=\"$namespace\",service=~\"$service\",pod=~\"$pod\"})",
          "legendFormat": "{{signal}} {{outcome}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "미수집",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
