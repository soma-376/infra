    {
      "id": 6,
      "type": "stat",
      "title": "확인된 commit 기준 lag",
      "description": "미커밋 partition을 제외한 commit 기준 offset lag(record 수)다. 옆 미커밋 수가 0이 아니면 전체 backlog를 뜻하지 않는다. 모두 미커밋·group 미생성·수집 실패는 빈 값이며 0으로 바꾸지 않는다. http 모드에서는 해당 없다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pulsemetry:kafka_committed_lag:sum{topic=\"$topic\",consumergroup=\"$consumer_group\",cluster=\"$cluster\",kafka_cluster=\"$kafka_cluster\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "pulsemetry-prometheus"
          },
          "legendFormat": "{{consumergroup}} {{topic}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "미수집",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "links": [
        {
          "title": "같은 시간의 Kafka Pod 진단 로그",
          "url": "/d/pulsemetry-diagnostics?${__url_time_range}&${environment:queryparam}&${cluster:queryparam}&${namespace:queryparam}&${service:queryparam}&${pod:queryparam}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Kafka PVC 사용률",
      "description": "100Gi PVC 3개의 사용률을 확인한다. 사용률 85% 초과(여유 15% 미만)이면 용량/보존을 조정하고 PVC를 삭제하지 않는다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - kubelet_volume_stats_available_bytes{cluster=\"$cluster\",namespace=\"$namespace\",persistentvolumeclaim=~\"data-[0-9]+-$kafka_cluster-dual-role-[0-9]+\"} / kubelet_volume_stats_capacity_bytes{cluster=\"$cluster\",namespace=\"$namespace\",persistentvolumeclaim=~\"data-[0-9]+-$kafka_cluster-dual-role-[0-9]+\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "pulsemetry-prometheus"
          },
          "legendFormat": "{{pod}} {{instance}} {{type}} {{consumergroup}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "미수집 · targets/labels 확인",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "links": [
        {
          "title": "같은 시간의 Kafka Pod 진단 로그",
          "url": "/d/pulsemetry-diagnostics?${__url_time_range}&${environment:queryparam}&${cluster:queryparam}&${namespace:queryparam}&${service:queryparam}&${pod:queryparam}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Broker CPU",
      "description": "broker/controller 겸용 컨테이너의 CPU다. request1/노드2vCPU이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(pod)(rate(container_cpu_usage_seconds_total{cluster=\"$cluster\",namespace=\"$namespace\",pod=~\"$kafka_cluster-dual-role-[0-9]+\",container=\"kafka\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "pulsemetry-prometheus"
          },
          "legendFormat": "{{pod}} {{instance}} {{type}} {{consumergroup}}"
        }
