{
  "uid": "pulsemetry-kafka",
  "title": "Pulsemetry · Strimzi Kafka",
  "description": "Strimzi 1.3.0/Kafka 4.2.2의 broker·commit lag·Pod/PVC·인증서 상태다. 지표가 없으면 수집 상태와 운영자 reconciliation을 확인하며 0으로 대체하지 않는다. 시각은 UTC다.",
  "tags": [
    "pulsemetry",
    "PROJ-283"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "constant",
        "query": "__ENVIRONMENT__",
        "hide": 2,
        "current": {
          "text": "__ENVIRONMENT__",
          "value": "__ENVIRONMENT__"
        }
      },
      {
        "name": "namespace",
        "type": "constant",
        "query": "__TARGET_NAMESPACE__",
        "hide": 2,
        "current": {
          "text": "__TARGET_NAMESPACE__",
          "value": "__TARGET_NAMESPACE__"
        }
      },
      {
        "name": "cluster",
        "type": "constant",
        "query": "__CLUSTER_NAME__",
        "hide": 2,
        "current": {
          "text": "__CLUSTER_NAME__",
          "value": "__CLUSTER_NAME__"
        }
      },
      {
        "name": "kafka_cluster",
        "type": "constant",
        "query": "__KAFKA_CLUSTER__",
        "hide": 2,
        "current": {
          "text": "__KAFKA_CLUSTER__",
          "value": "__KAFKA_CLUSTER__"
        }
      },
      {
        "name": "topic",
        "type": "constant",
        "query": "__TOPIC__",
        "hide": 2,
        "current": {
          "text": "__TOPIC__",
          "value": "__TOPIC__"
        }
      },
      {
        "name": "consumer_group",
        "type": "constant",
        "query": "__CONSUMER_GROUP__",
        "hide": 2,
        "current": {
          "text": "__CONSUMER_GROUP__",
          "value": "__CONSUMER_GROUP__"
        }
      },
      {
        "name": "testid",
        "label": "k6 실행",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsemetry-prometheus"
        },
        "query": "label_values(k6_http_reqs_total{environment=\"$environment\",cluster=\"$cluster\"}, testid)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "실행을 선택하세요",
          "value": ""
        }
      },
      {
        "name": "application",
        "label": "앱",
        "type": "custom",
        "query": "telemetry-gateway,telemetry-ingest",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsemetry-prometheus"
        },
        "query": "label_values(up{cluster=\"$cluster\",namespace=\"$namespace\",job=~\"telemetry-gateway|telemetry-ingest|clickhouse\"}, service)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsemetry-prometheus"
        },
        "query": "label_values(up{cluster=\"$cluster\",namespace=\"$namespace\",service=~\"$service\",job=~\"telemetry-gateway|telemetry-ingest|clickhouse\"}, pod)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 180, 0, 1)",
        "name": "실행 구간과 운영 개입",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 180, 0, 1)",
        "name": "공유 k6 실행 구간",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [
            "pulsemetry-run",
            "$testid"
          ],
          "type": "tags"
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Pulsemetry 대시보드",
      "tags": [
        "pulsemetry"
      ],
      "keepTime": true,
      "includeVars": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Kafka scrape 상태",
      "description": "JMX3/exporter1/CO1/EO2 endpoint의 실제 수집 성공 여부다. 빈 값을 정상으로 바꾸지 않는다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"strimzi-jmx|strimzi-exporter|strimzi-cluster-operator|strimzi-entity-operator\",cluster=\"$cluster\",kafka_cluster=\"$kafka_cluster\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "pulsemetry-prometheus"
          },
          "legendFormat": "{{pod}} {{instance}} {{type}} {{consumergroup}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "미수집 · targets/labels 확인",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "links": [
        {
          "title": "같은 시간의 Kafka Pod 진단 로그",
          "url": "/d/pulsemetry-diagnostics?${__url_time_range}&${environment:queryparam}&${cluster:queryparam}&${namespace:queryparam}&${service:queryparam}&${pod:queryparam}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Kafka record 수신",
      "description": "Kafka record의 초당 수신량이며 OTLP 행 수와 다르다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pulsemetry:kafka_messages:rate1m{topic=\"$topic\",cluster=\"$cluster\",kafka_cluster=\"$kafka_cluster\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "pulsemetry-prometheus"
          },
          "legendFormat": "{{pod}} {{instance}} {{type}} {{consumergroup}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "미수집 · targets/labels 확인",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "links": [
        {
          "title": "같은 시간의 Kafka Pod 진단 로그",
          "url": "/d/pulsemetry-diagnostics?${__url_time_range}&${environment:queryparam}&${cluster:queryparam}&${namespace:queryparam}&${service:queryparam}&${pod:queryparam}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Under replicated partitions",
      "description": "ISR 이탈 partition 수다. broker 한 개 장애 시 상승할 수 있다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_server_replicamanager_underreplicatedpartitions{job=\"strimzi-jmx\",cluster=\"$cluster\",kafka_cluster=\"$kafka_cluster\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "pulsemetry-prometheus"
          },
          "legendFormat": "{{pod}} {{instance}} {{type}} {{consumergroup}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "미수집 · targets/labels 확인",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "links": [
        {
          "title": "같은 시간의 Kafka Pod 진단 로그",
          "url": "/d/pulsemetry-diagnostics?${__url_time_range}&${environment:queryparam}&${cluster:queryparam}&${namespace:queryparam}&${service:queryparam}&${pod:queryparam}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Under min ISR",
      "description": "min ISR2 미달이면 acks=all 발행 성공이 불가능해야 한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_server_replicamanager_underminisrpartitioncount{job=\"strimzi-jmx\",cluster=\"$cluster\",kafka_cluster=\"$kafka_cluster\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "pulsemetry-prometheus"
          },
          "legendFormat": "{{pod}} {{instance}} {{type}} {{consumergroup}}"
        }
      ],
