    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Offline partitions",
      "description": "KRaft controller JMX 값이다. 미수집은 0이 아니며 controller endpoint를 확인한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_controller_kafkacontroller_offlinepartitionscount{job=\"strimzi-jmx\",cluster=\"$cluster\",kafka_cluster=\"$kafka_cluster\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "pulsemetry-prometheus"
          },
          "legendFormat": "{{pod}} {{instance}} {{type}} {{consumergroup}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
