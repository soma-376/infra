    {
      "id": 11,
      "type": "timeseries",
      "title": "TLS 인증 실패",
      "description": "TLS handshake 실패 counter 증가량이다. ACL 거부는 별도 부정 테스트/앱 로그에서 확인한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(listener)(increase(kafka_server_socket_server_metrics_failed_authentication_total{job=\"strimzi-jmx\",cluster=\"$cluster\",kafka_cluster=\"$kafka_cluster\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "pulsemetry-prometheus"
          },
