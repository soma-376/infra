    {
      "type": "timeseries",
      "title": "Offline partitions · CloudWatch 60초",
      "description": "MSK(KRaft)는 broker JMX로 OfflinePartitionsCount를 내지 않는다(2026-10-23 24시간 표본 0). 이 CloudWatch 값이 offline partition의 기준이다. 원본 60초 해상도이며 미수집 값을 0으로 바꾸지 않는다.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "pulsemetry-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "pulsemetry-cloudwatch"
          },
          "queryMode": "Metrics",
          "region": "__AWS_REGION__",
          "namespace": "AWS/Kafka",
          "metricName": "OfflinePartitionsCount",
          "dimensions": {
            "Cluster Name": "$msk_cluster"
          },
          "statistic": "Maximum",
          "period": "60",
          "matchExact": true,
          "metricEditorMode": 0,
          "metricQueryType": 0
        }
