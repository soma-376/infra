{
  "uid": "pulsemetry-msk",
  "title": "Pulsemetry · MSK",
  "description": "빈 시계열은 미수집/비활성/표본 부족이다. 0 또는 정상으로 대체하지 않는다. 시각은 UTC이며 HTTP ACK는 저장 완료가 아니다.",
  "tags": [
    "pulsemetry",
    "PROJ-191"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "constant",
        "query": "__ENVIRONMENT__",
        "hide": 2,
        "current": {
          "text": "__ENVIRONMENT__",
          "value": "__ENVIRONMENT__"
        }
      },
      {
        "name": "namespace",
        "type": "constant",
        "query": "__TARGET_NAMESPACE__",
        "hide": 2,
        "current": {
          "text": "__TARGET_NAMESPACE__",
          "value": "__TARGET_NAMESPACE__"
        }
      },
      {
        "name": "cluster",
        "type": "constant",
        "query": "__CLUSTER_NAME__",
        "hide": 2,
        "current": {
          "text": "__CLUSTER_NAME__",
          "value": "__CLUSTER_NAME__"
        }
      },
      {
        "name": "msk_cluster",
        "type": "constant",
        "query": "__MSK_CLUSTER__",
        "hide": 2,
        "current": {
          "text": "__MSK_CLUSTER__",
          "value": "__MSK_CLUSTER__"
        }
      },
      {
        "name": "topic",
        "type": "constant",
        "query": "__TOPIC__",
        "hide": 2,
        "current": {
          "text": "__TOPIC__",
          "value": "__TOPIC__"
        }
      },
      {
        "name": "consumer_group",
        "type": "constant",
        "query": "__CONSUMER_GROUP__",
        "hide": 2,
        "current": {
          "text": "__CONSUMER_GROUP__",
          "value": "__CONSUMER_GROUP__"
        }
      },
      {
        "name": "testid",
        "label": "k6 실행",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsemetry-prometheus"
        },
        "query": "label_values(k6_http_reqs_total{environment=\"$environment\",cluster=\"$cluster\"}, testid)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "실행을 선택하세요",
          "value": ""
        }
      },
      {
        "name": "application",
        "label": "앱",
        "type": "custom",
        "query": "telemetry-gateway,telemetry-ingest",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsemetry-prometheus"
        },
        "query": "label_values(up{cluster=\"$cluster\",namespace=\"$namespace\",job=~\"telemetry-gateway|telemetry-ingest|clickhouse\"}, service)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsemetry-prometheus"
        },
        "query": "label_values(up{cluster=\"$cluster\",namespace=\"$namespace\",service=~\"$service\",job=~\"telemetry-gateway|telemetry-ingest|clickhouse\"}, pod)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 180, 0, 1)",
        "name": "실행 구간과 운영 개입",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 180, 0, 1)",
        "name": "공유 k6 실행 구간",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [
            "pulsemetry-run",
            "$testid"
          ],
          "type": "tags"
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Pulsemetry 대시보드",
      "tags": [
        "pulsemetry"
      ],
      "keepTime": true,
      "includeVars": true
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "JMX / Node 전체 broker 수집 상태",
      "description": "현재 scrape 성공(1)·실패(0)다. msk-jmx는 60초, msk-node는 10초 간격이다. JMX endpoint가 HTTP 429로 거부하면 0이 된다. 간헐 실패의 비율은 옆 패널에서 본다. 빈 시계열은 대상 미설정이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"msk-jmx|msk-node\",environment=\"$environment\",cluster=\"$cluster\",msk_cluster=\"$msk_cluster\"}",
          "legendFormat": "{{job}} {{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "미수집",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "links": [
        {
          "title": "같은 시간·서비스·Pod의 진단 로그",
          "url": "/d/pulsemetry-diagnostics?${__url_time_range}&${environment:queryparam}&${cluster:queryparam}&${namespace:queryparam}&${service:queryparam}&${pod:queryparam}&${testid:queryparam}",
          "targetBlank": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "broker별 최근 15분 수집 성공률",
      "description": "예정된 scrape 중 성공한 비율(최근 15분)이다. 1 미만이면 그 broker의 지표에 수집 공백이 있다. MSK JMX의 HTTP 429 거부가 주원인이며, 해당 구간의 JMX 패널 값은 마지막 성공 표본이다. 빈 시계열은 대상 미설정이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pulsemetry:msk_scrape_success:ratio15m{environment=\"$environment\",cluster=\"$cluster\",msk_cluster=\"$msk_cluster\"}",
          "legendFormat": "{{job}} {{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "미수집",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 17,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "links": [
        {
          "title": "같은 시간·서비스·Pod의 진단 로그",
          "url": "/d/pulsemetry-diagnostics?${__url_time_range}&${environment:queryparam}&${cluster:queryparam}&${namespace:queryparam}&${service:queryparam}&${pod:queryparam}&${testid:queryparam}",
          "targetBlank": false
        }
      ]
    },
