  "panels": [
    {
      "type": "timeseries",
      "title": "요청 결과 / 초",
      "description": "빈 시계열은 대상 없음·수집 실패·지표 미적용·필터 불일치·표본 부족 중 하나일 수 있다. 수집 경로와 k6 첫 화면의 수집 상태 표로 수집 여부를 먼저 보고, 정상이어도 이벤트 없음으로 단정하지 않는다. 0으로 대체하지 않으며 시각은 UTC다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsemetry-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(signal,status,outcome)(rate(pulsemetry_gateway_requests_total{environment=\"$environment\",cluster=\"$cluster\",namespace=\"$namespace\",service=~\"$service\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{signal}} {{status}} {{outcome}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "값 없음 · 첫 화면 수집 상태 확인",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
