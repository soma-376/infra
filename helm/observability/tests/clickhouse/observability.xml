<clickhouse>
  <prometheus>
    <endpoint>/metrics</endpoint><port>9363</port>
    <metrics>true</metrics><events>true</events>
    <asynchronous_metrics>true</asynchronous_metrics><errors>true</errors>
  </prometheus>
  <logger>
    <level>information</level><console>1</console>
    <log remove="remove"/><errorlog remove="remove"/>
    <formatting><type>json</type></formatting>
  </logger>
</clickhouse>
