{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clusterName",
    "stage",
    "availabilityZone"
  ],
  "properties": {
    "clusterName": {
      "const": "soma-376-dev-telemetry"
    },
    "stage": {
      "enum": [
        "validation",
        "main"
      ]
    },
    "availabilityZone": {
      "type": "string",
      "pattern": "^ap-northeast-2[a-z]$"
    }
  }
}
