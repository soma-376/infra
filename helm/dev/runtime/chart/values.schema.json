{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "region",
    "secrets",
    "userAuth",
    "telemetryJwt"
  ],
  "properties": {
    "region": {
      "const": "ap-northeast-2"
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dbArn",
        "tokenHashArn",
        "adminApiTokenArn",
        "dashboardRdsSourceArn",
        "dashboardRdsCacheArn",
        "dashboardClickHouseSourceArn",
        "dashboardClickHouseCacheArn",
        "userJwtPrivateKeyArn",
        "userJwtPublicKeysArn",
        "telemetryJwtPrivateKeyArn",
        "telemetryJwtPublicKeysArn"
      ],
      "properties": {
        "dbArn": {
          "type": "string",
          "pattern": "^arn:aws:secretsmanager:ap-northeast-2:[0-9]{12}:secret:.+$"
        },
        "tokenHashArn": {
          "type": "string",
          "pattern": "^arn:aws:secretsmanager:ap-northeast-2:[0-9]{12}:secret:.+$"
        },
        "adminApiTokenArn": {
          "type": "string",
          "pattern": "^arn:aws:secretsmanager:ap-northeast-2:[0-9]{12}:secret:.+$"
        },
        "dashboardRdsSourceArn": {
          "type": "string",
          "pattern": "^arn:aws:secretsmanager:ap-northeast-2:[0-9]{12}:secret:.+$"
        },
        "dashboardRdsCacheArn": {
          "type": "string",
          "pattern": "^arn:aws:secretsmanager:ap-northeast-2:[0-9]{12}:secret:.+$"
        },
        "dashboardClickHouseSourceArn": {
          "type": "string",
          "pattern": "^arn:aws:secretsmanager:ap-northeast-2:[0-9]{12}:secret:.+$"
        },
        "dashboardClickHouseCacheArn": {
          "type": "string",
          "pattern": "^arn:aws:secretsmanager:ap-northeast-2:[0-9]{12}:secret:.+$"
        },
        "userJwtPrivateKeyArn": {
          "type": "string",
          "pattern": "^arn:aws:secretsmanager:ap-northeast-2:[0-9]{12}:secret:.+$"
        },
        "userJwtPublicKeysArn": {
          "type": "string",
          "pattern": "^arn:aws:secretsmanager:ap-northeast-2:[0-9]{12}:secret:.+$"
        },
        "telemetryJwtPrivateKeyArn": {
          "type": "string",
          "pattern": "^arn:aws:secretsmanager:ap-northeast-2:[0-9]{12}:secret:.+$"
        },
        "telemetryJwtPublicKeysArn": {
          "type": "string",
          "pattern": "^arn:aws:secretsmanager:ap-northeast-2:[0-9]{12}:secret:.+$"
        }
      }
    },
    "userAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privateVersionId",
        "publicVersionId",
        "activeKid",
        "publicKeys"
      ],
      "properties": {
        "privateVersionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{32,64}$"
        },
        "publicVersionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{32,64}$"
        },
        "activeKid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\[\\]\\x00-\\x1f\\x7f]+$"
        },
        "publicKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kid",
              "alias"
            ],
            "properties": {
              "kid": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\[\\]\\x00-\\x1f\\x7f]+$"
              },
              "alias": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*\\.pem$"
              }
            }
          }
        }
      }
    },
    "telemetryJwt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privateVersionId",
        "publicVersionId",
        "activeKid",
        "publicKeys"
      ],
      "properties": {
        "privateVersionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{32,64}$"
        },
        "publicVersionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{32,64}$"
        },
        "activeKid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\[\\]\\x00-\\x1f\\x7f]+$"
        },
        "publicKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kid",
              "alias"
            ],
            "properties": {
              "kid": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\[\\]\\x00-\\x1f\\x7f]+$"
              },
              "alias": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*\\.pem$"
              }
            }
          }
        }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowInsecureLocalhost": {
          "type": "boolean"
        },
        "callbackBaseUrl": {
          "type": "string",
          "pattern": "^https?://(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*\\.?(?::[0-9]{1,5})?|\\[[0-9A-Fa-f:.]+\\](?::[0-9]{1,5})?)/?$"
        },
        "callbackRegistrationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "failureRedirectUri": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^https?://(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*\\.?(?::[0-9]{1,5})?|\\[[0-9A-Fa-f:.]+\\](?::[0-9]{1,5})?)(?:/(?:[-A-Za-z0-9._~!$&'()*+;=:@/]|%[A-Fa-f0-9]{2})*)?$"
        },
        "clients": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "versionId",
              "secretArn",
              "alias"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "versionId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]{32,64}$"
              },
              "secretArn": {
                "type": "string",
                "pattern": "^arn:aws:secretsmanager:ap-northeast-2:[0-9]{12}:secret:soma-376/dev/oidc/clients/[A-Za-z0-9_-]{1,64}-[A-Za-z0-9]{6}$"
              },
              "alias": {
                "type": "string",
                "pattern": "^PULSEMETRY_OIDC_CLIENT_SECRET_([0-9]|[12][0-9]|3[01])$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "callbackBaseUrl",
              "callbackRegistrationId",
              "clients"
            ]
          },
          "else": {
            "maxProperties": 1
          }
        }
      ]
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "management": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "secretArn",
            "versionId"
          ],
          "properties": {
            "secretArn": {
              "type": "string",
              "pattern": "^arn:aws:secretsmanager:ap-northeast-2:[0-9]{12}:secret:soma-376/dev/management/response-encryption-key-[A-Za-z0-9]{6}$"
            },
            "versionId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{32,64}$"
            }
          }
        },
        "mail": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "secretArn",
            "versionId"
          ],
          "properties": {
            "secretArn": {
              "type": "string",
              "pattern": "^arn:aws:secretsmanager:ap-northeast-2:[0-9]{12}:secret:soma-376/dev/mail/encryption-key-[A-Za-z0-9]{6}$"
            },
            "versionId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{32,64}$"
            }
          }
        }
      }
    }
  }
}
