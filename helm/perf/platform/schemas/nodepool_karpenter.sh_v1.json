{
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "spec": {
      "properties": {
        "disruption": {
          "default": {
            "consolidateAfter": "0s"
          },
          "properties": {
            "budgets": {
              "default": [
                {
                  "nodes": "10%"
                }
              ],
              "items": {
                "properties": {
                  "duration": {
                    "pattern": "^((([0-9]+(h|m))|([0-9]+h[0-9]+m))(0s)?)$",
                    "type": "string"
                  },
                  "nodes": {
                    "default": "10%",
                    "pattern": "^((100|[0-9]{1,2})%|[0-9]+)$",
                    "type": "string"
                  },
                  "reasons": {
                    "items": {
                      "enum": [
                        "Underutilized",
                        "Empty",
                        "Drifted",
                        "NodeNotHealthy"
                      ],
                      "type": "string"
                    },
                    "maxItems": 50,
                    "type": "array",
                    "x-kubernetes-list-type": "set"
                  },
                  "schedule": {
                    "pattern": "^(@(annually|yearly|monthly|weekly|daily|midnight|hourly))|((.+)\\s(.+)\\s(.+)\\s(.+)\\s(.+))$",
                    "type": "string"
                  }
                },
                "required": [
                  "nodes"
                ],
                "type": "object"
              },
              "maxItems": 50,
              "type": "array",
              "x-kubernetes-list-type": "atomic",
              "x-kubernetes-validations": [
                {
                  "message": "'schedule' must be set with 'duration'",
                  "rule": "self.all(x, has(x.schedule) == has(x.duration))"
                }
              ]
            },
            "consolidateAfter": {
              "pattern": "^(([0-9]+(s|m|h))+|Never)$",
              "type": "string"
            },
            "consolidationPolicy": {
              "default": "WhenEmptyOrUnderutilized",
              "enum": [
                "WhenEmpty",
                "WhenEmptyOrUnderutilized",
                "Balanced"
              ],
              "type": "string"
            }
          },
          "required": [
            "consolidateAfter"
          ],
          "type": "object"
        },
        "limits": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "pattern": "^(\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))))?$",
