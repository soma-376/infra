{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "environment-lock.schema.json",
  "title": "환경 lock v2 — 환경 전용 ConfigMap의 data.lock.json",
  "description": "ConfigMap을 원자적으로 만든 쪽이 소유자다. heartbeat는 없다. Job deadline이 무인 유입을 제한한다",
  "type": "object",
  "required": [
    "schema_version", "kind", "state", "environment_id", "deployment_id", "experiment_id", "run_id", "owner",
    "acquired_at", "job_name", "job_deadline_at"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "environment-lock"},
    "state": {"enum": ["held", "releasing"]},
    "environment_id": {"$ref": "common.schema.json#/$defs/slug"},
    "deployment_id": {"$ref": "common.schema.json#/$defs/slug"},
    "experiment_id": {"type": "string", "pattern": "^[0-9]{4}-[a-z0-9]+(-[a-z0-9]+)*$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "owner": {"$ref": "common.schema.json#/$defs/non_empty"},
    "acquired_at": {"$ref": "common.schema.json#/$defs/utc"},
    "job_name": {"anyOf": [{"$ref": "common.schema.json#/$defs/slug"}, {"type": "null"}]},
    "job_deadline_at": {"$ref": "common.schema.json#/$defs/utc"}
  },
  "additionalProperties": false
}
