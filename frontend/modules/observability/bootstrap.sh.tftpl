#!/bin/bash
set -euo pipefail
# 비밀 값은 출력하지 않는다. cloud-init 실패 시 스택도 실행하지 않는다.
dnf install -y docker openssl xfsprogs util-linux
systemctl enable --now docker
install -d -m 0755 /usr/local/lib/docker/cli-plugins /opt/pulsemetry-observability
curl --fail --location --retry 5 https://github.com/docker/compose/releases/download/v2.39.4/docker-compose-linux-aarch64 -o /usr/local/lib/docker/cli-plugins/docker-compose
printf '%s  %s\n' 49082844b87f03cdcd5f5bbef1ba8c9c897b7a2dfb80cea18d61ec8ca6117e0c /usr/local/lib/docker/cli-plugins/docker-compose | sha256sum -c -
chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose
%{ for name, body in files ~}
install -d "$(dirname '/opt/pulsemetry-observability/${name}')"
printf '%s' '${body}' | base64 -d > '/opt/pulsemetry-observability/${name}'
%{ endfor ~}
# NVMe 장치 순서 대신 Terraform이 만든 volume ID로만 디스크를 선택한다.
volume='${volume_id}'
serial=$(printf '%s' "$volume" | tr -d '-')
device="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$serial"
for attempt in $(seq 1 120); do
  test -b "$device" && break
  sleep 5
done
test -b "$device"
# 새 빈 볼륨만 초기화한다. 기존의 알 수 없는 파일시스템은 덮어쓰지 않는다.
if ! blkid "$device" >/dev/null 2>&1; then
  test -z "$(wipefs -n --noheadings -o TYPE "$device")"
  mkfs.xfs "$device"
fi
test "$(blkid -s TYPE -o value "$device")" = xfs
uuid=$(blkid -s UUID -o value "$device")
install -d /srv/pulsemetry-observability
if ! grep -q "UUID=$uuid " /etc/fstab; then
  printf 'UUID=%s /srv/pulsemetry-observability xfs defaults,nofail 0 2\n' "$uuid" >> /etc/fstab
fi
mount /srv/pulsemetry-observability
mountpoint -q /srv/pulsemetry-observability
install -d /srv/pulsemetry-observability/{alloy,alloy-host,prometheus,loki,tempo,grafana,secrets}
password=/srv/pulsemetry-observability/secrets/grafana-admin-password
if ! test -s "$password"; then
  umask 077
  openssl rand -hex 32 > "$password"
fi
chown 10001:10001 "$password"
chmod 0400 "$password"
# 호스트만 IMDS를 사용한다. 컨테이너에는 인스턴스 자격증명을 공급하지 않는다.
TOKEN=$(curl --fail --retry 3 -sS -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token)
INSTANCE=$(curl --fail -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
PRIVATE_IP=$(curl --fail -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)
printf 'HOST_INSTANCE_ID=%s\nHOST_PRIVATE_IP=%s\n' "$INSTANCE" "$PRIVATE_IP" > /opt/pulsemetry-observability/.env
chmod 0600 /opt/pulsemetry-observability/.env
# Docker의 자동 재시작도 데이터 마운트 이후에만 허용한다.
install -d /etc/systemd/system/docker.service.d
cat > /etc/systemd/system/docker.service.d/observability-mount.conf <<'MOUNT'
[Unit]
RequiresMountsFor=/srv/pulsemetry-observability
MOUNT
cat > /etc/systemd/system/pulsemetry-observability.service <<'UNIT'
[Unit]
Description=Pulsemetry frontend observability
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/pulsemetry-observability
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/pulsemetry-observability
ExecStartPre=/usr/bin/mountpoint -q /srv/pulsemetry-observability
ExecStart=/usr/bin/docker compose up -d --wait --wait-timeout 180
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=900
TimeoutStopSec=120
Restart=on-failure
RestartSec=30
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now pulsemetry-observability
