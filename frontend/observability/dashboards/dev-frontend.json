        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(container_memory_usage_bytes{service_name=\"pulsemetry-frontend\",deployment_environment_name=\"dev\"}) and on(service_instance_id) (frontend_container_collection_success{service_name=\"pulsemetry-frontend\",deployment_environment_name=\"dev\"} == 1)",
          "legendFormat": "사용량 · {{service_instance_id}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "(container_memory_limit_bytes{service_name=\"pulsemetry-frontend\",deployment_environment_name=\"dev\"}) and on(service_instance_id) (frontend_container_collection_success{service_name=\"pulsemetry-frontend\",deployment_environment_name=\"dev\"} == 1)",
          "legendFormat": "한도 · {{service_instance_id}}",
          "range": true
