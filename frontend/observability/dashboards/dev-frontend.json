      "options": {
        "content": "AZ와 EC2 필터는 이 OS 영역에만 적용됩니다. 범례는 가용영역 · EC2 ID입니다. OS 수치는 호스트 전체이며 Node 프로세스 수치와 별개입니다.",
        "mode": "markdown"
      },
      "title": "dev EC2 · AZ별 OS 자원",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 7
      },
      "id": 11,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - avg by (instance, environment, host_role, availability_zone) (rate(node_cpu_seconds_total{job=\"frontend-host\",environment=\"dev\",host_role=\"frontend-dev\",availability_zone=~\"$az\",instance=~\"$instance\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{availability_zone}} · {{instance}}",
          "refId": "A"
        }
      ],
      "title": "EC2 CPU 사용률 · 전체 코어 평균 (%)",
